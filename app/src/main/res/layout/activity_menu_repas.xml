<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="top|center"
    android:orientation="vertical"
    tools:context=".MenuRepasActivity">

    <Button
        android:id="@+id/boutonRetour"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_margin="16dp"
        android:text="@string/btn_retour"
        android:layout_marginBottom="25dp"
        />

    <TextView
        android:id="@+id/textVue2Participation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mes participations"
        android:layout_marginBottom="16dp"
        />

    <Button
        android:id="@+id/boutonParticipation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="suivant"
        android:layout_marginBottom="16dp"
        />

    <TextView
        android:id="@+id/textVue2Recherche"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recherche Repas Activity"
        android:layout_marginBottom="16dp"
        />

    <Button
        android:id="@+id/boutonRecherche"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="suivant" />

</LinearLayout>