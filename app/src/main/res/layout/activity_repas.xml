<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="top|center"
    android:orientation="vertical"
    tools:context=".RepasActivity">

    <Button
        android:id="@+id/boutonRetour"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_margin="16dp"
        android:text="@string/btn_retour"
        android:layout_marginBottom="16dp"
        />

    <TextView
        android:id="@+id/ListeRepasActivity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Liste des repas à venir auxquels est inscrit l'utilisateur"
        android:layout_marginBottom="16dp"
        />

    <TextView
        android:id="@+id/TextViewDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:layout_marginBottom="16dp"
        />

    <TextView
        android:id="@+id/TextViewSpecialite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:layout_marginBottom="16dp"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRepas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        />

</LinearLayout>